@proceedings{bpmds:2024:vanderaa:enterprise,
  editor   = {{van der Aa}, Han and Bork, Dominik and Schmidt, Rainer and Sturm, Arnon},
  title    = {Enterprise, Business-Process and Information Systems Modeling - 25th International Conference, {BPMDS} 2024, and 29th International Conference, {EMMSAD} 2024, Limassol, Cyprus, June 3-4, 2024, Proceedings},
  volume   = {511},
  year     = {2024},
