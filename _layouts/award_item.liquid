---
{% comment %}
  One line of the Distinctions overview on the publications page
  ({% bibliography -q @*[award] -T award_item %}): the award, then the paper's
  authors and a link to its page.
{% endcomment %}
<strong>{{ entry.award }}:</strong>
{% for author in entry.author_array -%}
  {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
  {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
    <em class="self-name">
      {{- author.first }}
      {{ author_last_name -}}
    </em>
  {%- else -%}
    {{ author.first }}
    {{ author_last_name }}
  {%- endif -%}
  {%- unless forloop.last %}, {% endunless -%}
{%- endfor -%}
:
<a href="{{ details }}">{{ entry.title }}</a>
